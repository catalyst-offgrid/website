---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import xIcon from "../assets/images/icons/x-twitter.png";
import linkedinIcon from "../assets/images/icons/linkedin.png";
---
<BaseLayout title="Contact">
  <section class="bg-white">
    <div class="max-w-3xl mx-auto px-6 pt-16 pb-20 text-center">
      <h1 class="section-heading">Contact Us</h1>
      <p class="mt-4 font-display text-lg text-brand-blue">We'd love to hear from you</p>

      <p class="mt-8 text-slate-700 leading-relaxed">
        If you're interested in learning more about the work that we do at Catalyst, please send us an email at
        <a href="mailto:info@catalyst-advisors.com" class="text-brand-gold hover:underline">info@catalyst-advisors.com</a>.
      </p>
      <p class="mt-4 text-slate-700 leading-relaxed">
        We are always looking for passionate and talented people to join our team. If you are interested in being considered, send your CV to
        <a href="mailto:jobs@catalyst-advisors.com" class="text-brand-gold hover:underline">jobs@catalyst-advisors.com</a>.
      </p>

      <div class="mt-8 flex justify-center gap-4">
        <a href="#" aria-label="X (Twitter)" class="w-10 h-10 rounded-full bg-slate-200 hover:bg-brand-gold/30 flex items-center justify-center">
          <Image src={xIcon} alt="" class="w-4 h-4" width={16} height={16} />
        </a>
        <a href="#" aria-label="LinkedIn" class="w-10 h-10 rounded-full bg-slate-200 hover:bg-brand-gold/30 flex items-center justify-center">
          <Image src={linkedinIcon} alt="" class="w-4 h-4" width={16} height={16} />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
