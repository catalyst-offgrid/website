---
import BaseLayout from "../layouts/BaseLayout.astro";
import envelope from "../assets/images/icons/envelope.svg?raw";
import { site } from "../data/site";

const contactChannels = [
  {
    label: "General inquiries",
    blurb: "Curious about our work, partnerships, or how we can help your organization.",
    email: "info@catalyst-advisors.com",
  },
  {
    label: "Careers",
    blurb: "Passionate practitioners wanting to join our decentralized, global team.",
    email: "jobs@catalyst-advisors.com",
  },
];
---
<BaseLayout title="Contact">
  <!-- HERO + CARDS -->
  <section class="bg-white">
    <div class="max-w-6xl mx-auto px-6 sm:px-10 lg:px-16 pt-20 pb-24">
      <div class="grid lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] gap-14 lg:gap-20 items-start">

        <!-- LEFT: editorial heading -->
        <div class="lg:pt-6">
          <p class="font-display text-sm tracking-[0.22em] uppercase text-brand-gold">
            Get in touch
          </p>
          <h1 class="mt-5 font-display font-light text-5xl sm:text-6xl leading-[1.02] text-brand-blue">
            We'd love <span class="italic font-normal">to hear</span><br/>
            <span class="text-brand-gold">from you.</span>
          </h1>
          <div class="mt-8 border-l-2 border-brand-gold pl-5 max-w-md">
            <p class="text-lg text-slate-700 leading-relaxed">
              Whether you're exploring a partnership, pitching a mandate, or interested in joining the team — pick the right line below and drop us a note.
            </p>
          </div>
        </div>

        <!-- RIGHT: contact cards -->
        <div class="space-y-5">
          {contactChannels.map((c) => (
            <a
              href={`mailto:${c.email}`}
              class="group block border border-slate-200 bg-white p-7 sm:p-8 transition-all duration-300 hover:border-brand-gold hover:shadow-[0_12px_40px_-20px_rgba(0,46,93,0.35)] hover:-translate-y-0.5"
            >
              <div class="flex items-start justify-between gap-6">
                <div class="min-w-0">
                  <p class="font-display text-xs tracking-[0.2em] uppercase text-brand-gold">
                    {c.label}
                  </p>
                  <p class="mt-3 text-base text-slate-600 leading-relaxed">
                    {c.blurb}
                  </p>
                  <div class="mt-5 flex items-center gap-3">
                    <span class="block w-4 h-4 text-brand-blue" set:html={envelope}></span>
                    <span class="font-display text-lg sm:text-xl text-brand-blue group-hover:text-brand-gold transition-colors break-all">
                      {c.email}
                    </span>
                  </div>
                </div>
                <span
                  aria-hidden="true"
                  class="shrink-0 mt-1 font-display text-2xl text-brand-gold translate-x-0 group-hover:translate-x-1 transition-transform"
                >&rsaquo;</span>
              </div>
            </a>
          ))}
        </div>

      </div>
    </div>
  </section>

</BaseLayout>
