---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ContactForm from "../components/ContactForm.astro";
import { site } from "../data/site";
---
<BaseLayout title="Contact">
  <Hero title="Get in touch." subtitle="We'd love to hear from you." />

  <section>
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-16 grid gap-12 md:grid-cols-2">
      <div>
        <h2 class="font-display text-2xl font-light text-brand-blue">Send us a message</h2>
        <p class="mt-3 text-slate-700">Tell us about your project or your organization. We typically respond within a few business days.</p>
        <div class="mt-8">
          <ContactForm />
        </div>
      </div>
      <div>
        <h2 class="font-display text-2xl font-light text-brand-blue">Or reach us directly</h2>
        <p class="mt-3 text-slate-700">Prefer email?</p>
        <a href={`mailto:${site.contactEmail}`} class="mt-2 inline-block text-lg text-brand-cyan font-semibold hover:underline">{site.contactEmail}</a>
        <p class="mt-8 text-sm text-slate-600 leading-relaxed">
          Catalyst is headquartered in Berkeley, California. Our team's decentralized, global presence includes New York, Nairobi, Paris, Maputo, Lusaka, Lagos, and Washington DC.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
