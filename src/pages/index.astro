---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { values } from "../data/values";
import { expertise } from "../data/expertise";
import { partners } from "../data/partners";
import heroVillage from "../assets/images/heroes/home-village.jpg";
import worldMap from "../assets/images/heroes/world-map.png";
import nightlights from "../assets/images/heroes/nightlights.jpg";
import catalystLockup from "../assets/images/logos/catalyst-lockup.svg?raw";

// Pre-load partner logos via glob so <Image> can optimize them.
const partnerImages = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/images/partners/*.{png,jpg,jpeg,webp}",
  { eager: true }
);
function partnerImg(filename: string) {
  const entry = Object.entries(partnerImages).find(([k]) => k.endsWith("/" + filename));
  return entry?.[1].default;
}
---
<BaseLayout>
  <!-- HERO -->
  <section class="relative">
    <Image src={heroVillage} alt="Aerial view of a village in sub-Saharan Africa" class="absolute inset-0 w-full h-full object-cover" width={1600} height={900} />
    <div class="absolute inset-0 bg-brand-blue/70"></div>
    <div class="relative max-w-6xl mx-auto px-6 py-24 sm:py-32 flex">
      <div class="bg-brand-gold/50 backdrop-blur-[1px] px-8 py-10 sm:px-10 sm:py-12 max-w-3xl text-white">
        <h1 class="font-display font-light text-2xl sm:text-3xl md:text-4xl leading-tight">
          <span class="text-white">Catalyst Energy Advisors</span> <span class="text-brand-gold">is a specialized consulting firm that focuses exclusively on the energy access deficit in emerging markets.</span>
        </h1>
        <p class="mt-6 text-base sm:text-lg text-white font-light leading-relaxed">
          We help transform markets that power lives and livelihoods.
        </p>
        <p class="mt-4 text-base sm:text-lg text-white font-light leading-relaxed">
          Our vision is a world where every community is powered by clean, reliable, and sustainable energy.
        </p>
      </div>
    </div>
  </section>

  <!-- DEFINITION PANEL -->
  <section class="relative bg-brand-blue-dark text-white overflow-hidden">
    <Image src={nightlights} alt="" class="absolute inset-0 w-full h-full object-cover opacity-80" width={1600} height={800} aria-hidden="true" />
    <div class="absolute inset-0 bg-brand-blue/50"></div>
    <div class="relative max-w-6xl mx-auto px-6 py-20 grid md:grid-cols-2 gap-10 items-center">
      <div class="flex justify-center md:justify-start">
        <div class="w-[200px] flex items-center justify-center" set:html={catalystLockup}></div>
      </div>
      <div>
        <p class="font-display text-2xl sm:text-3xl font-light leading-relaxed">
          <span class="text-brand-gold font-normal">Catalyst</span> <span class="text-white/80">/ˈkæt̬.əl.ɪst/</span> — someone or something that <u class="decoration-brand-gold underline-offset-4">causes a big change</u>.
        </p>
        <p class="mt-6 text-white/85 leading-relaxed">
          Through its work, our firm seeks to manifest its name. Our values underpin our expertise.
        </p>
      </div>
    </div>
  </section>

  <!-- OUR VALUES -->
  <section class="bg-white">
    <div class="max-w-6xl mx-auto px-6 py-20">
      <h2 class="section-heading">Our Values</h2>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {values.map((v) => (
          <div class="border-t-2 border-brand-gold pt-5">
            <h3 class="font-display text-lg font-semibold text-brand-blue">{v.title}</h3>
            <p class="mt-3 text-sm text-slate-700 leading-relaxed">{v.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- OUR EXPERTISE -->
  <section class="bg-slate-50">
    <div class="max-w-6xl mx-auto px-6 py-20">
      <h2 class="section-heading">Our Expertise</h2>
      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {expertise.map((e, i) => {
          const gold = (i % 2) === 0;
          return (
            <div class:list={[
              "p-6 rounded-sm",
              gold ? "bg-brand-gold text-brand-blue" : "bg-brand-blue text-white"
            ]}>
              <h3 class="font-display text-base font-semibold">{e.title}</h3>
              <p class={`mt-3 text-sm leading-relaxed ${gold ? "text-brand-blue/90" : "text-white/90"}`}>{e.body}</p>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- WHERE WE'VE WORKED -->
  <section class="bg-white">
    <div class="max-w-6xl mx-auto px-6 py-20">
      <h2 class="section-heading">Where We've Worked</h2>
      <div class="mt-10 grid md:grid-cols-2 gap-10 items-center">
        <p class="text-slate-700 leading-relaxed">
          Catalyst's team comes from the energy access industry, having assembled best-in-class experts based around the world, many of whom have spent considerable time in emerging markets working on engagements with, for, and on behalf of private-sector, multilateral, non-profit, and government entities. The team's experience extends to over 50 countries and covers a range of energy technologies from pico-PV products to utility-scale hydro and solar facilities.
        </p>
        <Image src={worldMap} alt="Map of countries where Catalyst has worked" width={800} height={500} />
      </div>
    </div>
  </section>

  <!-- PARTNERS AND CLIENTS -->
  <section class="bg-white">
    <div class="max-w-6xl mx-auto px-6 pb-20">
      <h2 class="section-heading">Some of Our Partners And Clients</h2>
      <div class="mt-12 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-x-8 gap-y-10 items-center justify-items-center">
        {partners.map((p) => {
          const img = partnerImg(p.logo);
          if (!img) return null;
          return <Image src={img} alt={p.name} class="max-h-16 w-auto object-contain" />;
        })}
      </div>
    </div>
  </section>
</BaseLayout>
