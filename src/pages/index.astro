---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { values } from "../data/values";
import { expertise } from "../data/expertise";
import { partners, innovations } from "../data/partners";
import catalystIcon from "../assets/images/logos/catalyst-blue.png";
import heroVillage from "../assets/images/heroes/home-village.jpg";
import nightlights from "../assets/images/heroes/nightlights.jpg";
import worldMap from "../assets/images/map/world-map.png";
import mapLegend from "../assets/images/map/map-legend.png";

const partnerImages = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/images/partners/*.{png,jpg,jpeg,webp}",
  { eager: true }
);
function partnerImg(filename: string) {
  const entry = Object.entries(partnerImages).find(([k]) => k.endsWith("/" + filename));
  return entry?.[1].default;
}
---
<BaseLayout>
  <!-- HERO -->
  <section class="relative min-h-[600px] flex items-center overflow-hidden">
    <Image src={heroVillage} alt="" class="absolute inset-0 w-full h-full object-cover" width={2000} height={1125} />
    <div class="relative max-w-7xl mx-auto w-full px-6 py-16 flex justify-center text-white">
      <div class="relative w-full max-w-5xl bg-emerald-950/55 backdrop-blur-[1px] px-8 sm:px-14 py-10 sm:py-14">
        <h1 class="font-display font-bold text-3xl sm:text-4xl leading-tight">
          <span class="text-white">Catalyst Energy Advisors</span> <span class="text-brand-gold">is a specialized consulting firm that focuses exclusively on the energy access deficit in emerging markets</span>
        </h1>
        <div class="mt-8 border-l-2 border-brand-gold pl-5 space-y-4 max-w-[calc(100%-10rem)]">
          <p class="text-xl sm:text-2xl font-semibold leading-relaxed">
            We help transform markets that power lives and livelihoods.
          </p>
          <p class="text-xl sm:text-2xl font-semibold leading-relaxed">
            Our vision is a world where every community is powered by clean, reliable, and sustainable energy.
          </p>
        </div>
        <Image src={catalystIcon} alt="" aria-hidden="true" class="absolute right-8 bottom-8 w-20 h-20 sm:w-24 sm:h-24 opacity-95 pointer-events-none" width={234} height={234} />
      </div>
    </div>
  </section>

  <!-- DEFINITION PANEL -->
  <section class="relative bg-brand-blue text-white">
    <Image src={nightlights} alt="" class="absolute inset-0 w-full h-full object-cover opacity-70" width={2000} height={1000} />
    <div class="absolute inset-0 bg-brand-blue/50"></div>
    <div class="relative max-w-5xl mx-auto px-6 py-20 grid md:grid-cols-[200px_1fr] gap-10 items-center">
      <Image src={catalystIcon} alt="Catalyst" class="w-[200px] h-auto" width={400} height={400} />
      <div>
        <p class="font-display text-2xl sm:text-3xl leading-snug">
          <span class="text-brand-gold font-medium">Catalyst</span> <span class="text-white/60">/ˈkæt̬.əl.ɪst/</span> &mdash; someone or something that <span class="underline decoration-brand-gold underline-offset-4">causes a big change</span>
        </p>
        <p class="mt-6 text-white/90 leading-relaxed">
          Through its work, our firm seeks to manifest its name. Our values underpin our expertise:
        </p>
      </div>
    </div>
  </section>

  <!-- OUR VALUES: stacked vertical, alternating title color, larger text -->
  <section class="bg-white">
    <div class="max-w-4xl mx-auto px-6 py-20">
      <h2 class="section-heading section-heading-lg">Our Values</h2>
      <div class="mt-12 space-y-10">
        {values.map((v, i) => {
          const gold = (i % 2) === 1;
          return (
            <div class="border-l-2 border-brand-blue pl-6">
              <h3 class:list={["font-display text-2xl sm:text-3xl font-semibold", gold ? "text-brand-gold" : "text-brand-blue"]}>{v.title}</h3>
              <p class="mt-3 text-lg text-slate-700 leading-relaxed">{v.body}</p>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- OUR EXPERTISE: 4 across, all blue bg, gold title, white body -->
  <section class="bg-slate-50">
    <div class="max-w-6xl mx-auto px-6 py-20">
      <h2 class="section-heading section-heading-lg">Our Expertise</h2>
      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {expertise.map((e) => (
          <div class="p-6 bg-brand-blue text-white">
            <h3 class="font-display text-lg font-semibold text-brand-gold">{e.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-white/90">{e.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- INNOVATIONS — gold full-width box -->
  <section class="bg-slate-50">
    <div class="max-w-6xl mx-auto px-6 pb-20">
      <a href="/innovations" class="block bg-brand-blue text-white p-8 sm:p-10 hover:bg-brand-blue-dark transition-colors">
        <h2 class="font-display font-semibold text-2xl sm:text-3xl text-brand-gold">Innovations</h2>
        <p class="mt-4 text-base sm:text-lg leading-relaxed text-white/90">
          We're entrepreneurs, and have a natural itch to identify solutions to market failures and opportunities that we see in the energy access space. This includes conceptualizing and rolling out <strong class="text-brand-gold">VentureBuilder</strong>, <strong class="text-brand-gold">Access Insights Platform</strong> and the <strong class="text-brand-gold">MAF Lab</strong> (formerly PAYGo Lab).
        </p>
        <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-brand-gold">
          Learn more about our innovations <span aria-hidden>&rsaquo;</span>
        </span>
      </a>
    </div>
  </section>

  <!-- WHERE WE'VE WORKED: heading+text on left, world map with legend overlay on right -->
  <section class="bg-white">
    <div class="max-w-6xl mx-auto px-6 py-20">
      <div class="grid md:grid-cols-2 gap-10 items-center">
        <div>
          <h2 class="font-display font-light text-brand-gold text-3xl sm:text-4xl leading-tight">Where We've Worked</h2>
          <p class="mt-6 text-slate-700 leading-relaxed">
            Catalyst&rsquo;s team comes from the energy access industry, having assembled best-in-class experts based around the world, many of whom have spent considerable time in emerging markets working on engagements with, for, and on behalf of private-sector, multilateral, non-profit, and government entities. The team&rsquo;s experience extends to over 50 countries and covers a range of energy technologies from pico-PV products to utility-scale hydro and solar facilities.
          </p>
        </div>
        <div class="relative">
          <Image src={worldMap} alt="Map of countries where Catalyst has worked" class="w-full h-auto" width={900} height={500} />
          <Image src={mapLegend} alt="" aria-hidden="true" class="absolute bottom-2 right-2 w-28 sm:w-32 h-auto pointer-events-none drop-shadow" width={200} height={140} />
        </div>
      </div>
    </div>
  </section>

  <!-- PARTNERS AND CLIENTS: 4 across, 4 down -->
  <section class="bg-white">
    <div class="max-w-6xl mx-auto px-6 pb-24">
      <h2 class="section-heading">Some of Our Partners And Clients</h2>
      <div class="mt-14 grid grid-cols-2 md:grid-cols-4 gap-x-12 gap-y-14 items-center justify-items-center">
        {partners.map((p) => {
          const img = p.logo ? partnerImg(p.logo) : undefined;
          if (img) {
            return (
              <Image
                src={img}
                alt={p.name}
                class="max-h-20 w-auto max-w-[180px] object-contain"
              />
            );
          }
          return (
            <div class="flex flex-col items-center text-center text-brand-blue">
              <svg class="w-8 h-8 text-brand-blue" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="9"></circle>
                <path d="M3 12h18M12 3c2.5 3 4 6 4 9s-1.5 6-4 9M12 3c-2.5 3-4 6-4 9s1.5 6 4 9" stroke-linecap="round"></path>
              </svg>
              <div class="mt-2 text-[11px] font-semibold tracking-wider leading-tight uppercase">The<br />World<br />Bank</div>
            </div>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>
