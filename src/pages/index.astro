---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { values } from "../data/values";
import { expertise } from "../data/expertise";
import { partners } from "../data/partners";
import catalystIcon from "../assets/images/logos/catalyst-blue.png";
import heroVillage from "../assets/images/heroes/home-village.jpg";
import nightlights from "../assets/images/heroes/nightlights.jpg";
import worldMap from "../assets/images/map/world-map.png";

// Pre-load partner logos via glob so <Image> can optimize them.
const partnerImages = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/images/partners/*.{png,jpg,jpeg,webp}",
  { eager: true }
);
function partnerImg(filename: string) {
  const entry = Object.entries(partnerImages).find(([k]) => k.endsWith("/" + filename));
  return entry?.[1].default;
}
---
<BaseLayout>
  <!-- HERO: full-bleed village photo with white+gold split headline and corner icon -->
  <section class="relative min-h-[560px] flex items-center overflow-hidden">
    <Image src={heroVillage} alt="" class="absolute inset-0 w-full h-full object-cover" width={2000} height={1125} />
    <div class="absolute inset-0 bg-emerald-900/25"></div>
    <div class="relative max-w-6xl mx-auto w-full px-6 py-20 text-white">
      <div class="max-w-4xl">
        <h1 class="font-display font-semibold text-3xl sm:text-4xl md:text-5xl leading-tight">
          <span class="text-white">Catalyst Energy Advisors</span> <span class="text-brand-gold font-light">is a specialized consulting firm that focuses exclusively on the energy access deficit in emerging markets</span>
        </h1>
        <div class="mt-10 max-w-2xl border-l-2 border-brand-gold pl-6 space-y-5">
          <p class="text-base sm:text-lg leading-relaxed">
            We help transform markets that power lives and livelihoods.
          </p>
          <p class="text-base sm:text-lg leading-relaxed">
            Our vision is a world where every community is powered by clean, reliable, and sustainable energy.
          </p>
        </div>
      </div>
    </div>
    <Image src={catalystIcon} alt="" aria-hidden="true" class="absolute bottom-6 right-6 w-24 h-24 sm:w-32 sm:h-32 opacity-90 pointer-events-none" width={234} height={234} />
  </section>

  <!-- DEFINITION PANEL: nightlights background + gold lockup watermark + definition -->
  <section class="relative bg-brand-blue text-white">
    <Image src={nightlights} alt="" class="absolute inset-0 w-full h-full object-cover opacity-70" width={2000} height={1000} />
    <div class="absolute inset-0 bg-brand-blue/50"></div>
    <div class="relative max-w-5xl mx-auto px-6 py-20 grid md:grid-cols-[200px_1fr] gap-10 items-center">
      <Image src={catalystIcon} alt="Catalyst" class="w-[200px] h-auto" width={400} height={400} />
      <div>
        <p class="font-display text-2xl sm:text-3xl leading-snug">
          <span class="text-brand-gold font-medium">Catalyst</span> <span class="text-white/60">/ˈkæt̬.əl.ɪst/</span> &mdash; someone or something that <span class="underline decoration-brand-gold underline-offset-4">causes a big change</span>
        </p>
        <p class="mt-6 text-white/90 leading-relaxed">
          Through its work, our firm seeks to manifest its name. Our values underpin our expertise:
        </p>
      </div>
    </div>
  </section>

  <!-- OUR VALUES -->
  <section class="bg-white">
    <div class="max-w-6xl mx-auto px-6 py-20">
      <h2 class="section-heading">Our Values</h2>
      <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {values.map((v) => (
          <div class="border-t-2 border-brand-gold pt-5">
            <h3 class="font-display text-lg font-semibold text-brand-blue">{v.title}</h3>
            <p class="mt-3 text-sm text-slate-700 leading-relaxed">{v.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- OUR EXPERTISE: alternating gold/navy tiles -->
  <section class="bg-slate-50">
    <div class="max-w-6xl mx-auto px-6 py-20">
      <h2 class="section-heading">Our Expertise</h2>
      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {expertise.map((e, i) => {
          const gold = (i % 2) === 0;
          return (
            <div class:list={["p-6", gold ? "bg-brand-gold text-brand-blue" : "bg-brand-blue text-white"]}>
              <h3 class="font-display text-base font-semibold">{e.title}</h3>
              <p class={`mt-3 text-sm leading-relaxed ${gold ? "text-brand-blue/90" : "text-white/90"}`}>{e.body}</p>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- WHERE WE'VE WORKED -->
  <section class="bg-white">
    <div class="max-w-6xl mx-auto px-6 py-20">
      <h2 class="section-heading">Where We've Worked</h2>
      <div class="mt-12 grid md:grid-cols-2 gap-10 items-center">
        <p class="text-slate-700 leading-relaxed text-[15px]">
          Catalyst&rsquo;s team comes from the energy access industry, having assembled best-in-class experts based around the world, many of whom have spent considerable time in emerging markets working on engagements with, for, and on behalf of private-sector, multilateral, non-profit, and government entities. The team&rsquo;s experience extends to over 50 countries and covers a range of energy technologies from pico-PV products to utility-scale hydro and solar facilities.
        </p>
        <Image src={worldMap} alt="Map of countries where Catalyst has worked" width={900} height={500} />
      </div>
    </div>
  </section>

  <!-- PARTNERS AND CLIENTS -->
  <section class="bg-white">
    <div class="max-w-6xl mx-auto px-6 pb-24">
      <h2 class="section-heading">Some of Our Partners And Clients</h2>
      <div class="mt-14 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-x-10 gap-y-12 items-center justify-items-center">
        {partners.map((p) => {
          const img = partnerImg(p.logo);
          if (!img) return null;
          return <Image src={img} alt={p.name} class="max-h-16 w-auto object-contain" />;
        })}
      </div>
    </div>
  </section>
</BaseLayout>
