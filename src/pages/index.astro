---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { values } from "../data/values";
import { expertise } from "../data/expertise";
import { partners, innovations } from "../data/partners";
import catalystIcon from "../assets/images/logos/catalyst-blue.png";
import heroPoster from "../assets/images/heroes/home-hero-poster.jpg";
import nightlights from "../assets/images/heroes/nightlights.jpg";
import WorldMap from "../components/WorldMap.astro";

const partnerImages = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/images/partners/*.{png,jpg,jpeg,webp}",
  { eager: true }
);
function partnerImg(filename: string) {
  const entry = Object.entries(partnerImages).find(([k]) => k.endsWith("/" + filename));
  return entry?.[1].default;
}
---
<BaseLayout description="Catalyst Energy Advisors is a specialized consulting firm focused exclusively on the energy access deficit in emerging markets. We help transform markets that power lives and livelihoods.">
  <!-- HERO -->
  <section class="hero-section relative min-h-[600px] flex items-center overflow-hidden">
    <!-- Poster image: loads instantly, visible until video plays -->
    <Image src={heroPoster} alt="" class="hero-poster absolute inset-0 w-full h-full object-cover" width={1600} height={900} />
    <!-- Video: fades in once it can play; hidden on mobile + reduced-motion -->
    <video
      class="hero-video absolute inset-0 w-full h-full object-cover opacity-0 transition-opacity duration-700"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      poster={heroPoster.src}
      aria-hidden="true"
    >
      <source src="/videos/home-hero.mp4" type="video/mp4" />
    </video>
    <div class="relative max-w-7xl mx-auto w-full px-6 py-16 flex justify-center text-white">
      <div class="relative w-full max-w-5xl bg-emerald-950/55 backdrop-blur-[1px] px-8 sm:px-14 py-10 sm:py-14">
        <h1 class="font-display font-bold text-3xl sm:text-4xl leading-tight">
          <span class="text-white">Catalyst Energy Advisors</span> <span class="text-brand-gold">is a specialized consulting firm that focuses exclusively on the energy access deficit in emerging markets</span>
        </h1>
        <div class="mt-8 border-l-2 border-brand-gold pl-5 space-y-4 sm:max-w-[calc(100%-10rem)]">
          <p class="text-lg sm:text-2xl font-semibold leading-relaxed">
            We help transform markets that power lives and livelihoods.
          </p>
          <p class="text-lg sm:text-2xl font-semibold leading-relaxed">
            Our vision is a world where every community is powered by clean, reliable, and sustainable energy.
          </p>
        </div>
        <Image src={catalystIcon} alt="" aria-hidden="true" class="hidden sm:block absolute right-8 bottom-8 w-20 h-20 sm:w-24 sm:h-24 opacity-95 pointer-events-none" width={234} height={234} />
      </div>
    </div>
  </section>

  <!-- DEFINITION PANEL -->
  <section class="relative bg-brand-blue text-white">
    <Image src={nightlights} alt="" class="absolute inset-0 w-full h-full object-cover opacity-70" width={2000} height={1000} />
    <div class="absolute inset-0 bg-brand-blue/50"></div>
    <div class="relative max-w-5xl mx-auto px-6 py-20 grid md:grid-cols-[100px_1fr] gap-6 items-center">
      <Image src={catalystIcon} alt="Catalyst" class="hidden md:block w-[98px] h-auto" width={400} height={400} />
      <div>
        <p class="font-display text-2xl sm:text-3xl leading-snug">
          <span class="text-brand-gold font-medium">Catalyst</span> <span class="text-white/60">/ˈkæt̬.əl.ɪst/</span> &mdash; someone or something that<br class="hidden md:block" /> <span class="underline decoration-brand-gold underline-offset-4">causes a big change</span>
        </p>
        <p class="mt-6 text-white/90 leading-relaxed">
          Through its work, our firm seeks to manifest its name. Our values underpin our expertise:
        </p>
      </div>
    </div>
  </section>

  <!-- OUR VALUES: stacked vertical, alternating title color, larger text -->
  <section class="bg-white">
    <div class="max-w-4xl mx-auto px-6 pt-10 pb-20">
      <h2 class="section-heading section-heading-lg">Our Values</h2>
      <div class="mt-12 space-y-10">
        {values.map((v, i) => {
          const gold = (i % 2) === 1;
          return (
            <div class="border-l-2 border-brand-blue pl-6">
              <h3 class:list={["font-display text-2xl sm:text-3xl font-semibold", gold ? "text-brand-gold" : "text-brand-blue"]}>{v.title}</h3>
              <p class="mt-3 text-lg text-slate-700 leading-relaxed">{v.body}</p>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- OUR EXPERTISE: 4 across x 2 down — 7 expertise items + Innovations box = 8 tiles -->
  <section class="bg-slate-50">
    <div class="max-w-6xl mx-auto px-6 py-20">
      <h2 class="section-heading section-heading-lg">Our Expertise</h2>
      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {expertise.map((e) => (
          <div class="p-6 bg-brand-blue text-white">
            <h3 class="font-display text-lg font-semibold text-brand-gold">{e.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-white/90">{e.body}</p>
          </div>
        ))}
        <a href="/impact-studio" class="p-6 bg-brand-blue text-white hover:bg-brand-blue-dark transition-colors block">
          <h3 class="font-display text-lg font-semibold text-brand-gold">Impact Studio</h3>
          <p class="mt-3 text-sm leading-relaxed text-white/90">
            We're entrepreneurs, and have a natural itch to identify solutions to market failures and opportunities that we see in the energy access space. This includes conceptualizing and rolling out <strong class="text-brand-gold">VentureBuilder</strong>, <strong class="text-brand-gold">Access Insights Platform</strong> and the <strong class="text-brand-gold">MAF Lab</strong> (formerly PAYGo Lab).
          </p>
        </a>
      </div>
    </div>
  </section>

  <!-- WHERE WE'VE WORKED: heading+text on left, world map with legend overlay on right -->
  <section class="bg-white">
    <div class="max-w-6xl mx-auto px-6 pt-10 pb-20">
      <div class="grid md:grid-cols-2 gap-10 items-center">
        <div>
          <h2 class="font-display font-light text-brand-gold text-3xl sm:text-4xl leading-tight">Where We've Worked</h2>
          <p class="mt-6 text-slate-700 leading-relaxed">
            Catalyst&rsquo;s team comes from the energy access industry, having assembled best-in-class experts based around the world, many of whom have spent considerable time in emerging markets working on engagements with, for, and on behalf of private-sector, multilateral, non-profit, and government entities. The team&rsquo;s experience extends to over 50 countries and covers a range of energy technologies from pico-PV products to utility-scale hydro and solar facilities.
          </p>
        </div>
        <div class="relative">
          <WorldMap />
        </div>
      </div>
    </div>
  </section>

  <!-- PARTNERS AND CLIENTS: 4 across, 4 down -->
  <section class="bg-white">
    <div class="max-w-6xl mx-auto px-6 pb-24">
      <h2 class="section-heading">Some of Our Partners And Clients</h2>
      <div class="mt-6 grid grid-cols-2 md:grid-cols-4 gap-x-2 gap-y-8 items-center justify-items-center">
        {partners.map((p) => {
          if (p.logo?.endsWith(".svg")) {
            return <img src={`/logos/${p.logo}`} alt={p.name} class="max-h-20 w-auto max-w-[180px] object-contain" />;
          }
          const img = p.logo ? partnerImg(p.logo) : undefined;
          if (img) {
            return (
              <Image
                src={img}
                alt={p.name}
                class="max-h-20 w-auto max-w-[180px] object-contain"
              />
            );
          }
          return (
            <div class="flex flex-col items-center text-center text-brand-blue">
              <svg class="w-8 h-8 text-brand-blue" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="9"></circle>
                <path d="M3 12h18M12 3c2.5 3 4 6 4 9s-1.5 6-4 9M12 3c-2.5 3-4 6-4 9s1.5 6 4 9" stroke-linecap="round"></path>
              </svg>
              <div class="mt-2 text-[11px] font-semibold tracking-wider leading-tight uppercase">The<br />World<br />Bank</div>
            </div>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* On small screens or reduced-motion, skip the video entirely — poster stays */
  @media (max-width: 767px), (prefers-reduced-motion: reduce) {
    .hero-video { display: none !important; }
  }
</style>

<script is:inline>
  (function () {
    function initHeroVideo() {
      var v = document.querySelector(".hero-video");
      if (!v) return;
      var log = function (m) { try { console.log("[hero-video]", m); } catch (e) {} };
      // Respect reduced-motion: remove video element entirely so it never downloads
      if (window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        log("reduced-motion -> removed"); v.remove(); return;
      }
      // On narrow viewports, skip video to save mobile bandwidth
      if (window.matchMedia && window.matchMedia("(max-width: 767px)").matches) {
        log("narrow viewport -> removed"); v.remove(); return;
      }
      var reveal = function () { v.classList.remove("opacity-0"); log("revealed, readyState=" + v.readyState); };
      // If video is already playable by the time this runs, reveal immediately
      if (v.readyState >= 3) {
        reveal();
      } else {
        v.addEventListener("canplay", reveal, { once: true });
        v.addEventListener("loadeddata", reveal, { once: true });
        v.addEventListener("playing", reveal, { once: true });
      }
      v.addEventListener("error", function () { log("error: " + (v.error && v.error.message)); });
      // Some browsers block autoplay; attempt play explicitly
      var p = v.play();
      if (p && typeof p.catch === "function") {
        p.catch(function (err) { log("play() rejected: " + err.message); });
      }
      log("init complete, src=" + (v.currentSrc || "(pending)"));
    }
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initHeroVideo);
    } else {
      initHeroVideo();
    }
  })();
</script>
