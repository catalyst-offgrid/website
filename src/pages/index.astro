---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ValuePillar from "../components/ValuePillar.astro";
import ExpertiseArea from "../components/ExpertiseArea.astro";
import { values } from "../data/values";
import { expertise } from "../data/expertise";
import { innovations, partners } from "../data/partners";
import nightlights from "../assets/images/heroes/nightlights.jpg";
import ikea from "../assets/images/partners/ikea-foundation.png";
import lightrock from "../assets/images/partners/lightrock.jpg";
import mapLegend from "../assets/images/map/map-legend.png";
---
<BaseLayout>
  <Hero
    eyebrow="Catalyst Energy Advisors"
    title="Energy access in emerging markets."
    subtitle="A specialized consulting firm focused exclusively on closing the energy access deficit. We help transform the markets that power lives and livelihoods."
  />

  <section class="bg-slate-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-16 grid gap-10 md:grid-cols-2 items-center">
      <div>
        <div class="text-brand-gold text-sm font-semibold tracking-widest uppercase">Catalyst</div>
        <p class="font-display text-xl text-brand-blue mt-3">
          /ˈkæt̬.əl.ɪst/ — someone or something that causes <em>big change.</em>
        </p>
        <p class="mt-4 text-slate-700 leading-relaxed">
          Through its work, our firm seeks to manifest its name. Our values underpin our expertise.
        </p>
      </div>
      <Image src={nightlights} alt="NASA nightlights map of the world" class="rounded shadow-sm" />
    </div>
  </section>

  <section>
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-20">
      <h2 class="font-display text-3xl font-light text-brand-blue">Our values</h2>
      <div class="mt-8 grid gap-5 sm:grid-cols-2">
        {values.map((v) => <ValuePillar title={v.title} body={v.body} />)}
      </div>
    </div>
  </section>

  <section class="bg-slate-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-20">
      <h2 class="font-display text-3xl font-light text-brand-blue">Our expertise</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        {expertise.map((e) => <ExpertiseArea title={e.title} body={e.body} />)}
      </div>
    </div>
  </section>

  <section>
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-20">
      <h2 class="font-display text-3xl font-light text-brand-blue">Innovations</h2>
      <p class="mt-4 text-slate-700 max-w-3xl leading-relaxed">
        We're entrepreneurs, and have a natural itch to identify solutions to market failures and opportunities we see in the energy access space. This includes conceptualizing and rolling out:
      </p>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {innovations.map((i) => (
          <a href={i.url} target="_blank" rel="noopener" class="block p-6 bg-white border border-slate-200 hover:border-brand-cyan hover:shadow-sm transition">
            <div class="font-display text-lg font-semibold text-brand-blue">{i.name}</div>
            <p class="mt-2 text-sm text-slate-700 leading-relaxed">{i.summary}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-slate-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-20">
      <h2 class="font-display text-3xl font-light text-brand-blue">Where we've worked</h2>
      <p class="mt-4 text-slate-700 max-w-3xl">
        Catalyst is headquartered in Berkeley, California. Our team's decentralized, global presence includes New York, Nairobi, Paris, Maputo, Lusaka, Lagos, and Washington DC.
      </p>
      <Image src={mapLegend} alt="Map of countries where Catalyst has worked" class="mt-8 rounded" />
    </div>
  </section>

  <section>
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-16">
      <h2 class="font-display text-2xl font-light text-brand-blue">Some of our partners and clients</h2>
      <div class="mt-8 flex flex-wrap items-center gap-10">
        <Image src={ikea} alt="IKEA Foundation" class="h-14 w-auto opacity-80" />
        <Image src={lightrock} alt="Lightrock" class="h-10 w-auto opacity-80" />
        {partners.map((p) => (
          <a href={p.url} target="_blank" rel="noopener" class="text-brand-blue font-semibold hover:text-brand-cyan">{p.name}</a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
