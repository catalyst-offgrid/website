---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects, sectionCopy } from "../data/experience";

const imgs = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/images/experience/*.{png,jpg,jpeg,webp}",
  { eager: true }
);
function img(filename?: string) {
  if (!filename) return null;
  const entry = Object.entries(imgs).find(([k]) => k.endsWith("/" + filename));
  return entry?.[1].default ?? null;
}

const enterprise = projects.filter((p) => p.section === "enterprise");
const strategy = projects.filter((p) => p.section === "strategy");

const navButtonClass =
  "bg-brand-blue text-white font-semibold px-6 py-3 inline-flex items-center gap-2 hover:bg-brand-blue-dark transition";

const sections = [
  { id: "enterprise-development", copy: sectionCopy.enterprise, list: enterprise },
  { id: "strategy-insights", copy: sectionCopy.strategy, list: strategy },
];
---
<BaseLayout title="Experience" description="Selected Catalyst engagements across enterprise development, strategy and insights — from GET.invest finance readiness to flagship reports for Rockefeller, GEAPP, Shell Foundation, and SEforALL.">
  <!-- Intro band + three scroll-anchor buttons -->
  <section class="bg-white">
    <div class="max-w-5xl mx-auto px-6 pt-10 pb-8 text-center">
      <h1 class="section-heading">Our Experience</h1>
      <p class="mt-5 text-slate-700 leading-relaxed max-w-3xl mx-auto">
        We focus on catalyzing energy access in emerging markets through three core business units:
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href="#enterprise-development" class={navButtonClass}>
          Enterprise Development <span aria-hidden>&rsaquo;</span>
        </a>
        <a href="#strategy-insights" class={navButtonClass}>
          Strategy &amp; Insights <span aria-hidden>&rsaquo;</span>
        </a>
        <a href="#impact-studio" class={navButtonClass}>
          Impact Studio <span aria-hidden>&rsaquo;</span>
        </a>
      </div>
    </div>
  </section>

  {sections.map((sec, secIdx) => (
    <section id={sec.id} class="bg-white scroll-mt-24">
      <div class:list={["max-w-4xl mx-auto px-6 pb-12", secIdx === 0 ? "pt-8" : "pt-16"]}>
        <h2 class="section-heading">{sec.copy.heading}</h2>
        <p class="mt-5 text-center text-slate-700 leading-relaxed max-w-3xl mx-auto">
          {sec.copy.intro}
        </p>
        <div class="mt-12 grid gap-6 sm:grid-cols-2">
          {sec.list.map((p, idx) => {
            const image = img(p.image);
            const logo = img(p.logo);
            const isContain = p.display === "contain";
            const rightCol = idx % 2 === 1;
            return (
              <article class:list={[
                "tile relative overflow-hidden group bg-slate-100",
                sec.id === "strategy-insights" ? "aspect-[4/5]" : "aspect-square"
              ]} tabindex="0">
                {image && (
                  <Image
                    src={image}
                    alt={p.title}
                    class:list={[
                      "absolute inset-0 w-full h-full",
                      isContain ? "object-contain p-4" : "object-cover",
                    ]}
                    width={1080}
                  />
                )}
                {!isContain && !p.noBadge && (() => {
                  const logoList = p.logos && p.logos.length > 0 ? p.logos : (p.logo ? [p.logo] : []);
                  const isMulti = logoList.length > 1;
                  const logoCls = isMulti ? "max-h-8 w-auto object-contain" : (p.logoLarge ? "max-h-16 w-auto object-contain" : "max-h-12 w-auto object-contain");
                  if (logoList.length === 0) {
                    return (
                      <div class:list={["tile-logo-badge absolute top-4 z-20 flex items-center max-w-[45%]", rightCol ? "right-4 justify-end" : "left-4 justify-start"]}>
                        <span class="font-display text-sm font-bold text-white drop-shadow-[0_1px_2px_rgba(0,0,0,0.7)] leading-tight">{p.title}</span>
                      </div>
                    );
                  }
                  return (
                    <div class:list={[
                      "tile-logo-badge absolute top-4 z-20 flex items-center gap-3",
                      rightCol ? "right-4 justify-end" : "left-4 justify-start",
                      isMulti ? "" : "max-w-[45%]"
                    ]}>
                      {logoList.map((filename) => {
                        if (filename.endsWith(".svg")) {
                          return <img src={`/logos/${filename}`} alt="" class={logoCls} />;
                        }
                        const meta = img(filename);
                        return meta ? <Image src={meta} alt="" class={logoCls} /> : null;
                      })}
                    </div>
                  );
                })()}
                <div class="tile-overlay">
                  {!p.noBadge && (() => {
                    const logoList = p.logos && p.logos.length > 0 ? p.logos : (p.logo ? [p.logo] : []);
                    const isMulti = logoList.length > 1;
                    const logoCls = isMulti ? "max-h-8 w-auto object-contain" : (p.logoLarge ? "max-h-16 w-auto object-contain" : "max-h-12 w-auto object-contain");
                    if (logoList.length === 0) return null;
                    return (
                      <div class:list={["flex items-center gap-3 mb-4 sm:mb-7 shrink-0", rightCol ? "ml-auto" : "", !isMulti ? "max-w-[45%]" : ""]}>
                        {logoList.map((filename) => {
                          if (filename.endsWith(".svg")) return <img src={`/logos/${filename}`} alt="" class={logoCls} />;
                          const meta = img(filename);
                          return meta ? <Image src={meta} alt="" class={logoCls} /> : null;
                        })}
                      </div>
                    );
                  })()}
                  <div class="tile-body" set:html={p.body}></div>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>
  ))}

  <!-- Innovation -->
  <section id="impact-studio" class="bg-white scroll-mt-24">
    <div class="max-w-4xl mx-auto px-6 pt-8 pb-20 text-center">
      <h2 class="section-heading">{sectionCopy.innovation.heading}</h2>
      <p class="mt-5 text-slate-700 max-w-3xl mx-auto leading-relaxed">
        {sectionCopy.innovation.intro}
      </p>
      <a
        href="/impact-studio"
        class="mt-10 inline-block bg-brand-gold text-brand-blue font-semibold px-8 py-3 hover:bg-brand-gold-deep transition"
      >
        Learn more on the Impact Studio page &rsaquo;
      </a>
    </div>
  </section>

  <section class="bg-white">
    <div class="max-w-4xl mx-auto px-6 pb-3 text-center">
      <p class="text-xs text-slate-500">
        Photo credits: Acumen, BRILHO, Hailey Tucker (2023), SEforALL, Vecteezy, Zuwa Energy
      </p>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  function initCatalystTileTap() {
    var tiles = document.querySelectorAll(".tile");
    tiles.forEach(function (t) {
      if (t.dataset.tapBound === "1") return;
      t.dataset.tapBound = "1";
      t.addEventListener("click", function (e) {
        var wasOpen = t.classList.contains("is-open");
        document.querySelectorAll(".tile.is-open").forEach(function (o) {
          if (o !== t) o.classList.remove("is-open");
        });
        t.classList.toggle("is-open", !wasOpen);
      });
    });
  }
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initCatalystTileTap);
  } else {
    initCatalystTileTap();
  }
</script>
