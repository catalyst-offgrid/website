---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { enterpriseProjects, insightsProjects } from "../data/experience";

const projectImages = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/images/experience/*.{png,jpg,jpeg,webp}",
  { eager: true }
);
function projImg(filename: string) {
  const entry = Object.entries(projectImages).find(([k]) => k.endsWith("/" + filename));
  return entry?.[1].default;
}
---
<BaseLayout title="Experience">
  <section class="bg-white">
    <div class="max-w-5xl mx-auto px-6 pt-16 pb-8 text-center">
      <h1 class="section-heading">Our Experience</h1>
      <p class="mt-4 text-slate-700 leading-relaxed max-w-3xl mx-auto">
        We focus on catalyzing energy access in emerging markets through three core streams.
      </p>
      <div class="mt-8 inline-flex gap-0 border border-slate-200 rounded overflow-hidden" role="tablist">
        <button type="button" data-tab="ed" class="tab-btn bg-brand-blue text-white px-6 py-3 text-sm font-semibold">Enterprise Development</button>
        <button type="button" data-tab="si" class="tab-btn bg-white text-brand-blue px-6 py-3 text-sm font-semibold">Strategy &amp; Insights</button>
      </div>
    </div>
  </section>

  <!-- Enterprise Development -->
  <section id="panel-ed" class="tab-panel bg-white">
    <div class="max-w-6xl mx-auto px-6 pb-16">
      <h2 class="text-center font-display text-2xl font-light text-brand-blue mb-2">Enterprise Development</h2>
      <p class="text-center text-slate-700 max-w-2xl mx-auto mb-10">
        Thanks to our industry DNA, we thrive when mentoring and coaching energy access companies. A few examples of our enterprise development work:
      </p>
      <div class="grid gap-6 sm:grid-cols-2">
        {enterpriseProjects.map((p) => {
          const img = projImg(p.image);
          return (
            <article class="tile relative overflow-hidden rounded group" tabindex="0">
              {img && <Image src={img} alt={p.title} class="w-full h-64 object-cover" width={900} height={600} />}
              <div class="tile-overlay">
                <h3 class="font-display font-semibold text-lg mb-2">{p.title}</h3>
                <p class="text-sm leading-relaxed">{p.body}</p>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Strategy & Insights -->
  <section id="panel-si" class="tab-panel hidden bg-white">
    <div class="max-w-6xl mx-auto px-6 pb-16">
      <h2 class="text-center font-display text-2xl font-light text-brand-blue mb-2">Strategy &amp; Insights</h2>
      <p class="text-center text-slate-700 max-w-2xl mx-auto mb-10">
        Catalyst delivers market intelligence, financial analysis, and strategic advisory to key energy access stakeholders.
      </p>
      <div class="grid gap-6 sm:grid-cols-2">
        {insightsProjects.map((p) => {
          const img = projImg(p.image);
          return (
            <article class="tile relative overflow-hidden rounded group" tabindex="0">
              {img && <Image src={img} alt={p.title} class="w-full h-64 object-cover" width={900} height={600} />}
              <div class="tile-overlay">
                <h3 class="font-display font-semibold text-lg mb-2">{p.title}</h3>
                <p class="text-sm leading-relaxed">{p.body}</p>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="max-w-4xl mx-auto px-6 pb-16 text-center">
      <a href="/contact" class="inline-block bg-brand-gold text-brand-blue font-semibold px-8 py-3 rounded hover:bg-brand-gold-deep transition">Explore our Experience</a>
      <p class="mt-6 text-xs text-slate-500">Photo credits: BRILHO, Hailey Tucker (2023), SEforALL, Vecteezy, Zuwa Energy</p>
    </div>
  </section>
</BaseLayout>

<script is:inline>
(function () {
  var buttons = document.querySelectorAll('.tab-btn');
  var panels = {
    ed: document.getElementById('panel-ed'),
    si: document.getElementById('panel-si')
  };
  buttons.forEach(function (b) {
    b.addEventListener('click', function () {
      var key = b.getAttribute('data-tab');
      buttons.forEach(function (other) {
        var on = other === b;
        other.classList.toggle('bg-brand-blue', on);
        other.classList.toggle('text-white', on);
        other.classList.toggle('bg-white', !on);
        other.classList.toggle('text-brand-blue', !on);
      });
      Object.keys(panels).forEach(function (k) {
        if (panels[k]) panels[k].classList.toggle('hidden', k !== key);
      });
    });
  });
})();
</script>
