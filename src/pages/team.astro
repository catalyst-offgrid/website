---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { team, getInitials } from "../data/team";

const core = team.filter((m) => m.group === "core");
const advisors = team.filter((m) => m.group === "advisor");

const headshots = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/images/team/*.{png,jpg,jpeg,webp}",
  { eager: true }
);
function headshot(file?: string) {
  if (!file) return null;
  const entry = Object.entries(headshots).find(([k]) => k.endsWith("/" + file));
  return entry?.[1].default ?? null;
}
---
<BaseLayout title="Team">
  <section class="bg-white">
    <div class="max-w-5xl mx-auto px-6 sm:px-8 lg:px-10 pt-16 pb-6">
      <h1 class="section-heading section-heading-lg">Our Core Team</h1>
    </div>
  </section>

  <section class="bg-white">
    <div class="max-w-5xl mx-auto px-6 sm:px-8 lg:px-10 pb-20">
      <div class="grid gap-x-10 gap-y-16 sm:grid-cols-2 lg:grid-cols-3">
        {core.map((m) => {
          const img = headshot(m.headshot);
          return (
            <article class="text-center flex flex-col items-center">
              {img ? (
                <Image src={img} alt={m.name} class="w-44 h-44 rounded-full object-cover" width={352} height={352} />
              ) : (
                <div class="w-44 h-44 rounded-full bg-brand-blue text-white flex items-center justify-center font-display text-4xl">
                  {getInitials(m.name)}
                </div>
              )}
              <div class="mt-5 flex items-center justify-center gap-2">
                <h3 class="font-display text-2xl font-semibold text-brand-blue">{m.name}</h3>
                {m.linkedin && (
                  <a
                    href={m.linkedin}
                    target="_blank"
                    rel="noopener"
                    aria-label={`${m.name} on LinkedIn`}
                    class="shrink-0 w-7 h-7 rounded-full text-slate-400 flex items-center justify-center hover:text-brand-blue transition-colors"
                  >
                    <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.45 20.45h-3.555v-5.569c0-1.328-.025-3.037-1.852-3.037-1.853 0-2.136 1.447-2.136 2.94v5.666H9.352V9h3.414v1.561h.05c.476-.9 1.637-1.85 3.37-1.85 3.602 0 4.268 2.37 4.268 5.455v6.284zM5.337 7.433a2.063 2.063 0 1 1 0-4.126 2.063 2.063 0 0 1 0 4.126zM7.114 20.45H3.555V9h3.56v11.45zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.225.792 24 1.771 24h20.451C23.2 24 24 23.225 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                  </a>
                )}
              </div>
              <p class="text-[15px] text-brand-gold font-semibold uppercase tracking-wide">{m.role}</p>
              {m.bio && <p class="mt-3 text-[15px] text-slate-700 leading-relaxed text-justify max-w-[22rem]">{m.bio}</p>}
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="max-w-5xl mx-auto px-6 sm:px-8 lg:px-10 py-16">
      <h2 class="text-center font-display font-light text-4xl sm:text-5xl">
        <span class="text-brand-blue">Affiliated</span> <span class="text-brand-gold">Advisors</span>
      </h2>
      <div class="mt-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
        {advisors.map((m) => (
          <article>
            <h3 class="font-display text-base font-semibold text-brand-gold uppercase tracking-widest">{m.name}</h3>
            {m.bio && <p class="mt-3 text-[15px] text-slate-700 leading-relaxed text-justify">{m.bio}</p>}
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
