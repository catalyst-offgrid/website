---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  /** Override the social-share image. Defaults to /og-image.png. Must be an absolute path on the site. */
  ogImage?: string;
  /** Set to true on legal/utility pages to keep them out of search engines. */
  noindex?: boolean;
  /** Page-specific JSON-LD graph node(s), emitted after the site-wide Organization schema. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, ogImage, noindex, jsonLd } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.tagline}`;
const pageDescription = description ?? site.tagline;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? site.url).toString();
const ogImageURL = new URL(ogImage ?? "/og-image.png", Astro.site ?? site.url).toString();
const siteURL = (Astro.site ?? new URL(site.url)).toString().replace(/\/$/, "");

// Site-wide Organization schema (structured data for search engines / knowledge panels).
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${siteURL}/#organization`,
  name: site.name,
  url: `${siteURL}/`,
  logo: `${siteURL}/icon-512.png`,
  description:
    "Catalyst Energy Advisors is a specialized consulting firm focused exclusively on the energy access deficit in emerging markets.",
  email: site.contactEmail,
  address: {
    "@type": "PostalAddress",
    streetAddress: "1935 Addison Street, Suite A",
    addressLocality: "Berkeley",
    addressRegion: "CA",
    postalCode: "94704",
    addressCountry: "US",
  },
  sameAs: ["https://www.linkedin.com/company/catalystadvisors/"],
};

const schemas = [organizationSchema, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Favicons -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#002E5D" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Structured data (JSON-LD) -->
    {schemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body class="min-h-screen flex flex-col bg-white">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
