---
import { site } from "../data/site";
import mapPin from "../assets/images/icons/map-pin.svg?raw";
import envelope from "../assets/images/icons/envelope.svg?raw";
const year = new Date().getFullYear();
---
<footer class="bg-brand-blue text-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-14 grid gap-10 md:grid-cols-3">

    <!-- Col 1: Where we work -->
    <div class="flex gap-4">
      <span class="block w-8 h-8 shrink-0 text-brand-gold" set:html={mapPin}></span>
      <div>
        <h3 class="text-brand-gold font-display text-sm tracking-widest uppercase">Where we work</h3>
        <p class="mt-3 text-sm leading-relaxed text-white/90">
          Catalyst is headquartered in Berkeley, California. Our team's decentralized, global presence includes New York, Nairobi, Paris, Maputo, Lusaka, Lagos and Washington DC.
        </p>
      </div>
    </div>

    <!-- Col 2: Contact us + Join our team -->
    <div class="flex flex-col items-center text-center">
      <a href="/contact" class="block text-brand-gold font-display text-sm tracking-widest uppercase hover:text-white transition-colors">Contact us</a>
      <a href={`mailto:${site.contactEmail}`} class="mt-6 inline-flex items-center gap-3 text-brand-gold hover:text-white transition-colors">
        <span class="block w-5 h-5" set:html={envelope}></span>
        <span class="text-sm">{site.contactEmail}</span>
      </a>
      <a href="/joinourteam" class="mt-6 inline-block text-brand-gold font-display text-sm tracking-widest uppercase hover:text-white transition-colors">Join our team</a>
    </div>

    <!-- Col 3: About Catalyst + social buttons -->
    <div>
      <div class="flex items-center justify-between gap-3">
        <h3 class="text-brand-gold font-display text-sm tracking-widest uppercase">About Catalyst</h3>
        <div class="flex gap-3">
        <a href="https://twitter.com/CatalystOffGrid/" target="_blank" rel="noopener" aria-label="X" class="w-9 h-9 rounded-full border border-brand-gold flex items-center justify-center text-brand-gold hover:bg-brand-gold hover:text-brand-blue transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-4 h-4" fill="currentColor" aria-hidden="true"><path d="M18.244 2H21.5l-7.5 8.571L22.5 22h-6.813l-5.333-6.971L4.125 22H.867l8.063-9.214L.5 2h6.938l4.83 6.381L18.244 2zm-1.193 18h1.834L6.992 4H5.025l12.026 16z"/></svg>
        </a>
        <a href="https://www.linkedin.com/company/catalystadvisors/" target="_blank" rel="noopener" aria-label="LinkedIn" class="w-9 h-9 rounded-full border border-brand-gold flex items-center justify-center text-brand-gold hover:bg-brand-gold hover:text-brand-blue transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-4 h-4" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.555v-5.569c0-1.328-.025-3.037-1.852-3.037-1.853 0-2.136 1.447-2.136 2.94v5.666H9.352V9h3.414v1.561h.05c.476-.9 1.637-1.85 3.37-1.85 3.602 0 4.268 2.37 4.268 5.455v6.284zM5.337 7.433a2.063 2.063 0 1 1 0-4.126 2.063 2.063 0 0 1 0 4.126zM7.114 20.45H3.555V9h3.56v11.45zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.225.792 24 1.771 24h20.451C23.2 24 24 23.225 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
        </div>
      </div>
      <p class="mt-4 text-sm text-white/90 leading-relaxed">
        Catalyst is a specialized consulting firm that focuses exclusively on the energy access deficit in emerging markets.
      </p>
    </div>

  </div>

  <div class="border-t border-white/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-5 flex flex-col sm:flex-row items-center justify-between gap-3">
      <ul class="flex gap-6 text-xs tracking-wider uppercase text-white/80">
        <li><a href="/" class="hover:text-brand-gold">Home</a></li>
        <li><a href="/team" class="hover:text-brand-gold">Team</a></li>
        <li><a href="/experience" class="hover:text-brand-gold">Experience</a></li>
        <li><a href="/innovations" class="hover:text-brand-gold">Innovations</a></li>
      </ul>
      <p class="text-xs text-white/70">
        &copy; {year} Catalyst Energy Advisors. All rights reserved. Catalyst Privacy Policy can be found <a href="/privacy-policy" class="underline hover:text-brand-gold">here</a>.
      </p>
    </div>
  </div>
</footer>
