---
import { Image } from "astro:assets";
import { site } from "../data/site";
import linkedinIcon from "../assets/images/icons/linkedin.png";
import xIcon from "../assets/images/icons/x-twitter.png";
const year = new Date().getFullYear();
---
<footer class="bg-brand-blue text-white mt-0">
  <div class="max-w-6xl mx-auto px-6 sm:px-10 pt-14 pb-8">
    <div class="grid gap-10 md:grid-cols-3 items-start">
      <!-- LEFT: HQ -->
      <div class="flex gap-3 text-sm text-white/80 leading-relaxed">
        <svg class="w-5 h-5 flex-none text-brand-gold mt-0.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/>
        </svg>
        <p>
          Catalyst is headquartered in Berkeley, California. Our team's decentralized, global presence includes New York, Nairobi, Paris, Maputo, Lusaka, Lagos and Washington DC.
        </p>
      </div>

      <!-- MIDDLE: Join our team -->
      <div class="text-sm">
        <div class="text-brand-gold font-semibold mb-3">Join our team</div>
        <a href="/joinourteam" class="flex items-center gap-2 text-brand-gold hover:underline">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"/>
          </svg>
          info@catalyst-advisors.com
        </a>
      </div>

      <!-- RIGHT: About + socials -->
      <div class="text-sm text-white/80 leading-relaxed">
        <div class="flex justify-between items-start gap-6">
          <div>
            <div class="text-brand-gold font-semibold mb-3">About Catalyst</div>
            <p>Catalyst is a specialized consulting firm that focuses exclusively on the energy access deficit in emerging markets.</p>
          </div>
          <div class="flex gap-3 flex-none pt-1">
            <a href="#" aria-label="X (Twitter)" class="w-8 h-8 rounded-full border border-brand-gold/60 flex items-center justify-center hover:bg-white/10">
              <Image src={xIcon} alt="" class="w-4 h-4 opacity-90" width={16} height={16} />
            </a>
            <a href="#" aria-label="LinkedIn" class="w-8 h-8 rounded-full border border-brand-gold/60 flex items-center justify-center hover:bg-white/10">
              <Image src={linkedinIcon} alt="" class="w-4 h-4 opacity-90" width={16} height={16} />
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-white/10 mt-10 pt-6 flex flex-col items-center gap-3 text-xs text-white/70">
      <nav aria-label="Footer">
        <ul class="flex gap-6">
          <li><a href="/" class="hover:text-brand-gold">Home</a></li>
          <li><a href="/team" class="hover:text-brand-gold">Team</a></li>
          <li><a href="/experience" class="hover:text-brand-gold">Experience</a></li>
          <li><a href="/joinourteam" class="hover:text-brand-gold">More</a></li>
        </ul>
      </nav>
      <p class="text-center">
        &copy; {year} {site.name}. All rights reserved. Catalyst Privacy Policy can be found <a href="/privacy-policy" class="underline hover:text-brand-gold">here</a>.
      </p>
    </div>
  </div>
</footer>
