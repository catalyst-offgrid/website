---
import { site } from "../data/site";
---
<form
  id="contact-form"
  action={site.formspreeEndpoint}
  method="POST"
  class="max-w-xl space-y-5"
>
  <div>
    <label for="name" class="block text-sm font-semibold text-brand-blue">Name</label>
    <input id="name" name="name" type="text" required class="mt-1 block w-full rounded border border-slate-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand-cyan" />
  </div>
  <div>
    <label for="email" class="block text-sm font-semibold text-brand-blue">Email</label>
    <input id="email" name="email" type="email" required class="mt-1 block w-full rounded border border-slate-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand-cyan" />
  </div>
  <div>
    <label for="subject" class="block text-sm font-semibold text-brand-blue">Subject</label>
    <input id="subject" name="subject" type="text" class="mt-1 block w-full rounded border border-slate-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand-cyan" />
  </div>
  <div>
    <label for="message" class="block text-sm font-semibold text-brand-blue">Message</label>
    <textarea id="message" name="message" required rows="6" class="mt-1 block w-full rounded border border-slate-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand-cyan"></textarea>
  </div>
  <button type="submit" class="inline-flex items-center gap-2 bg-brand-gold text-brand-blue font-semibold px-6 py-3 rounded hover:bg-brand-gold/90 transition-colors">
    Send message
  </button>
  <p id="form-status" class="text-sm" role="status" aria-live="polite"></p>
</form>

<script is:inline define:vars={{ endpoint: site.formspreeEndpoint, contactEmail: site.contactEmail }}>
  const form = document.getElementById("contact-form");
  const status = document.getElementById("form-status");
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    status.textContent = "Sending…";
    status.className = "text-sm text-slate-600";
    try {
      const res = await fetch(endpoint, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });
      if (res.ok) {
        form.reset();
        status.textContent = "Thanks — we'll be in touch.";
        status.className = "text-sm text-green-700";
      } else {
        throw new Error("Submission failed");
      }
    } catch {
      status.innerHTML = `Something went wrong. Please email <a class="underline" href="mailto:${contactEmail}">${contactEmail}</a> directly.`;
      status.className = "text-sm text-red-700";
    }
  });
</script>
