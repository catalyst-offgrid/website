---
import { site } from "../data/site";
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---
<header class="bg-white border-b border-slate-200 sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-4 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3">
      <span class="font-display text-xl font-bold text-brand-blue">Catalyst</span>
      <span class="hidden sm:inline text-sm text-brand-blue/70">Energy Advisors</span>
    </a>
    <nav aria-label="Primary">
      <ul class="flex items-center gap-1 sm:gap-2">
        {site.nav.map((item) => {
          const normalized = item.href.replace(/\/$/, "") || "/";
          const isActive = currentPath === normalized;
          return (
            <li>
              <a
                href={item.href}
                class:list={[
                  "px-3 py-2 text-sm font-medium rounded hover:text-brand-cyan transition-colors",
                  isActive ? "text-brand-cyan" : "text-brand-blue"
                ]}
                aria-current={isActive ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>
