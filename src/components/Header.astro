---
import { site } from "../data/site";
import lockup from "../assets/images/logos/catalyst-lockup.svg?raw";
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---
<header class="bg-brand-blue text-white sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-4 flex items-center justify-between">
    <a href="/" class="flex items-center" aria-label="Catalyst Energy Advisors home">
      <span class="block" set:html={lockup}></span>
    </a>
    <nav aria-label="Primary">
      <ul class="flex items-center gap-2 sm:gap-5">
        {site.nav.map((item) => {
          const normalized = item.href.replace(/\/$/, "") || "/";
          const isActive = currentPath === normalized;
          return (
            <li>
              <a
                href={item.href}
                class:list={[
                  "px-1 py-2 text-sm font-medium transition-colors hover:text-brand-gold",
                  isActive ? "text-brand-gold" : "text-white"
                ]}
                aria-current={isActive ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>
