---
import lockup from "../assets/images/logos/catalyst-lockup.svg?raw";
import { site } from "../data/site";
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---
<header class="bg-brand-blue text-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-4 flex items-center justify-between gap-6">
    <a href="/" class="block shrink-0" aria-label="Catalyst Energy Advisors home">
      <span class="block w-[182px] h-[36px]" set:html={lockup}></span>
    </a>
    <nav aria-label="Primary">
      <ul class="flex items-center gap-2 sm:gap-6">
        {site.nav.map((item) => {
          const normalized = item.href.replace(/\/$/, "") || "/";
          const isActive = currentPath === normalized;
          return (
            <li>
              <a
                href={item.href}
                class:list={[
                  "text-sm tracking-wide hover:text-brand-gold transition-colors",
                  isActive ? "text-brand-gold" : "text-white"
                ]}
                aria-current={isActive ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>
