---
interface Props {
  title: string;
  subtitle?: string;
  eyebrow?: string;
}
const { title, subtitle, eyebrow } = Astro.props;
---
<section class="bg-brand-blue text-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-20 sm:py-28">
    {eyebrow && <div class="text-brand-gold text-sm font-semibold tracking-widest uppercase mb-4">{eyebrow}</div>}
    <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-light leading-tight max-w-3xl">{title}</h1>
    {subtitle && <p class="mt-6 text-lg sm:text-xl text-white/80 max-w-2xl">{subtitle}</p>}
  </div>
</section>
